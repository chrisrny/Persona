# Copy this file to .env and replace every "change-me" value.
# Never commit .env.

# --- n8n ---
# Version the workflows were built and tested with
N8N_VERSION=2.45.7
N8N_PORT=5678
# Encrypts the credentials stored in n8n. Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
# Default timezone of the instance (Schedule Trigger, dates)
GENERIC_TIMEZONE=Europe/Paris

# --- Postgres: admin role (used only by the container) ---
POSTGRES_USER=persona_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=persona

# --- Postgres: least-privilege role used by the n8n workflows ---
APP_DB_USER=persona_app
APP_DB_PASSWORD=change-me

# --- LLM (Ollama) ---
# Native Ollama on the host: http://host.docker.internal:11434
# Ollama in Docker (--profile ollama): http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Email (Gmail SMTP with an app password) ---
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=change-me
