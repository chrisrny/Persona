    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// First gate of the chat, before any database access or AI call.\n// Counters live in the workflow static data (kept by n8n between production runs).\nconst MAX_LENGTH = 1000;\nconst PER_SESSION = 20;   // messages per minute and per chat session\nconst GLOBAL = 200;        // messages per minute for the whole instance (protects Ollama)\nconst WINDOW_MS = 60 * 1000;\n\nconst now = Date.now();\nconst input = String($json.chatInput ?? '');\nconst sessionId = String($json.sessionId ?? '');\n\nconst reject = (reason, reply) => ({ json: { ...$json, allowed: false, reason, output: reply } });\n\nif (!sessionId) return reject('no_session', 'Missing chat session. Please reload the chat.');\nif (input.trim() === '') return reject('empty', 'Your message is empty.');\nif (input.length > MAX_LENGTH) {\n  return reject('too_long', 'Your message is too long (' + input.length + ' characters, max ' + MAX_LENGTH + '). Please shorten it.');\n}\n\nconst store = $getWorkflowStaticData('global');\nconst recent = (list) => (Array.isArray(list) ? list : []).filter((t) => now - t < WINDOW_MS);\n\nstore.global = recent(store.global);\nif (store.global.length >= GLOBAL) {\n  return reject('rate_global', 'Persona is very busy right now. Please try again in a minute.');\n}\n\nstore.sessions = store.sessions || {};\n// Forget sessions that have been quiet for a full window, to keep the store small\nfor (const [id, list] of Object.entries(store.sessions)) {\n  const kept = recent(list);\n  if (kept.length) store.sessions[id] = kept; else delete store.sessions[id];\n}\nconst mine = store.sessions[sessionId] || [];\nif (mine.length >= PER_SESSION) {\n  return reject('rate_session', 'You are sending messages too fast. Please wait a minute.');\n}\n\nmine.push(now);\nstore.sessions[sessionId] = mine;\nstore.global.push(now);\nreturn { json: { ...$json, allowed: true } };"
      },
