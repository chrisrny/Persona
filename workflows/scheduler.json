    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Utilisateurs dont le créneau vient d'arriver dans LEUR fuseau (fenêtre de 15 min\n-- pour rattraper un retard d'exécution) et qui n'ont rien reçu aujourd'hui.\n-- On les « réserve » tout de suite (last_sent_at = now()) : une exécution suivante,\n-- lancée pendant que la newsletter part, ne peut pas les reprendre (anti double envoi).\nUPDATE users u\nSET last_sent_at = now()\nWHERE u.active\n  AND u.email IS NOT NULL\n  AND u.send_time IS NOT NULL\n  AND (now() AT TIME ZONE u.timezone)::time - u.send_time\n      BETWEEN interval '0 minutes' AND interval '15 minutes'\n  AND (u.last_sent_at IS NULL\n       OR (u.last_sent_at AT TIME ZONE u.timezone)::date < (now() AT TIME ZONE u.timezone)::date)\nRETURNING u.id AS user_id;",
        "options": {}
      },
      "id": "b2d1f6e3-2a4c-4d7b-8f12-6c8e3a9b0002",
