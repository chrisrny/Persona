    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (\n  SELECT id, (password_hash = crypt($2, password_hash)) AS valid\n  FROM users WHERE id = $1::uuid\n), deleted AS (\n  DELETE FROM users WHERE id IN (SELECT id FROM target WHERE valid)\n  RETURNING id\n), failed AS (\n  UPDATE users u SET\n    failed_login_attempts = u.failed_login_attempts + 1,\n    locked_until = CASE WHEN u.failed_login_attempts + 1 >= 5\n                        THEN now() + interval '15 minutes' ELSE u.locked_until END\n  FROM target t\n  WHERE u.id = t.id AND NOT t.valid AND $2 <> ''\n  RETURNING u.id, u.failed_login_attempts AS attempts\n), kicked AS (\n  DELETE FROM sessions WHERE user_id IN (SELECT id FROM failed WHERE attempts >= 5)\n)\nSELECT EXISTS (SELECT 1 FROM deleted) AS deleted,\n       COALESCE((SELECT attempts >= 5 FROM failed), false) AS locked_out;",
        "options": {
          "queryReplacement": "={{ [ $('Find active session').first().json.user_id, ($('Chat Trigger').first().json.chatInput || '').trim().split(/\\s+/)[1] || '' ] }}"
        }
      },
