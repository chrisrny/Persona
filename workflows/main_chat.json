        "operation": "executeQuery",
        "query": "UPDATE sessions s\nSET expires_at = now() + interval '2 hours'\nFROM users u\nWHERE s.session_id = $1\n  AND s.expires_at > now()\n  AND u.id = s.user_id\nRETURNING s.user_id, u.username, u.role;",
        "options": {
          "queryReplacement": "={{ [ $('Chat Trigger').item.json.sessionId ] }}"
        }
      },
