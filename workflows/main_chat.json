      "parameters": {
        "public": true,
        "initialMessages": "Welcome to **Persona**, your personal AI news digest.\n\nTo get started:\n- `/register <username> <password> accept` to create an account\n- `/login <username> <password>` to log in\n\nUsername: 3 to 32 letters, digits or underscores. Password: 8 to 72 characters, no spaces.\n\n**Privacy:** Persona only stores your username, a hashed password, your email, your topics and your preferred delivery time, in order to send you your newsletter. You can view, pause or delete your data at any time from this chat. Adding `accept` to the register command means you agree to this.",
        "options": {
          "title": "Persona",
          "subtitle": "Your personal AI news digest",
          "inputPlaceholder": "Type a message or a command...",
          "responseMode": "lastNode"
        }
      },
